; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="QIX GAME"
config/description="Vertical slice: territory game inspired by Qix/Volfied. Working title."
run/main_scene="res://app/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/qix_game_icon.png"

[autoload]

_fennara_game_capture="*res://addons/fennara/runtime/game_capture_helper.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=240
window/size/viewport_height=320
window/size/window_width_override=720
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[dotnet]

project/assembly_name="QIX GAME"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

