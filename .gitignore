# ── Godot ────────────────────────────────────────────────────────────────────
# Cache de import e de class_name: regenerado por `--headless --path . --import`.
.godot/

# ── Ferramental de editor (MCP) ──────────────────────────────────────────────
# Estado local do Fennara e seus binários nativos de TODAS as plataformas (~28 MB).
# São ferramenta de editor, não runtime do jogo: o export hook já os remove do
# payload. Um checkout limpo baixa o addon; a nuvem não roda editor.
.fennara/
addons/fennara/bin/

# ── Artefatos de build ───────────────────────────────────────────────────────
# Exports macOS/Android do shipping pass (~139 MB). Reproduzíveis por
# tools/shipping/run_shipping_qa.sh; nunca são fonte da verdade.
build/

# ── Estado de sessão de agente (privado) ─────────────────────────────────────
.remember/
.claude/.cc-writes/
.claude/settings.local.json

# ── Biblioteca de terceiros sem consumidor ───────────────────────────────────
# Máquina de estados da Antipixel (3 cenas, 7 scripts, 132 KB). Removida do
# versionamento: nada em game/, ui/, app/, tools/, tests/ ou content/ a
# referenciava, nenhum dos seus 12 uid:// era citado de fora, e ela nunca foi
# instalada onde os próprios arquivos dela se esperam — as cenas e os @icon
# apontam para res://addons/antipixel_state_machine/, caminho que não existe.
# Custava cinco class_name genéricos no namespace global do projeto (State,
# StateMachine, StateComponent, NodeState, PackedSceneState), e o domínio deste
# jogo não pode consumi-la de todo modo: é `extends Node`, e o invariante 1
# proíbe Node/Tween/física em game/simulation/. Consultar na origem.
# Ver docs/PROJECT_CONTRACT.md § Raízes.
antipixel_state_machine/
# PDF do vendor, que acompanhava a pasta: consultar na origem, não versionar.
State Machine Antipixel Godot Documentation.pdf

# ── Demos de addons de terceiros ─────────────────────────────────────────────
# Projetos-exemplo que acompanham os addons GUIDE e softbody2d (~6 MB, 38 cenas).
# Nada no jogo os referencia — a dependência aponta só para dentro de addons/ —
# e os presets já os excluíam do export. Versionados, eram 38 das 43 cenas do
# repositório: toda busca por cena do jogo devolvia demo de vendor. Um deles
# ainda registrava `class_name LaserProjectile` no namespace global do projeto.
# Consultar na origem do addon, não aqui. Ver docs/PROJECT_CONTRACT.md § Raízes.
guide_examples/
samples/

# ── Bytecode de Python ───────────────────────────────────────────────────────
# O ferramental de `tools/ci/` e `tools/profile/` é Python, e o próprio comando
# documentado do portão de CI (`python3 -m unittest discover -s tools/ci`) escreve
# `__pycache__/` na árvore de trabalho antes de terminar. Sem regra aqui, o
# `git add -A` que o protocolo do loop prescreve varre esse bytecode para dentro
# do commit: foi assim que `tools/profile/__pycache__/*.cpython-314.pyc` chegou a
# `main` e que três PRs abertos acrescentaram `*.cpython-311.pyc` por cima.
# É binário derivado, preso à versão do interpretador que o gerou — o que estava
# versionado nem era do interpretador que a CI usa —, e binário o git não mescla:
# num repositório com fila de PRs, cada cópia é um conflito que não tem resolução
# útil. Regenerado por qualquer execução dos testes. Ver docs/PROJECT_CONTRACT.md.

# ── Ruído de SO / editor ─────────────────────────────────────────────────────
.DS_Store
*.tmp

# Bytecode derivado de Python, em qualquer profundidade.
__pycache__/
*.py[cod]
