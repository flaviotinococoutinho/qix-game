# ── Godot ────────────────────────────────────────────────────────────────────
# Cache de import e de class_name: regenerado por `--headless --path . --import`.
.godot/

# ── Ferramental de editor (MCP) ──────────────────────────────────────────────
# Estado local do Fennara e seus binários nativos de TODAS as plataformas (~28 MB).
# São ferramenta de editor, não runtime do jogo: o export hook já os remove do
# payload. Um checkout limpo baixa o addon; a nuvem não roda editor.
.fennara/
addons/fennara/bin/

# ── Artefatos de build ───────────────────────────────────────────────────────
# Exports macOS/Android do shipping pass (~139 MB). Reproduzíveis por
# tools/shipping/run_shipping_qa.sh; nunca são fonte da verdade.
build/

# ── Estado de sessão de agente (privado) ─────────────────────────────────────
.remember/
.claude/.cc-writes/
.claude/settings.local.json

# ── Documentação de terceiros redistribuída ──────────────────────────────────
# PDF do vendor do antipixel_state_machine: consultar na origem, não versionar.
State Machine Antipixel Godot Documentation.pdf

# ── Demos de addons de terceiros ─────────────────────────────────────────────
# Projetos-exemplo que acompanham os addons GUIDE e softbody2d (~6 MB, 38 cenas).
# Nada no jogo os referencia — a dependência aponta só para dentro de addons/ —
# e os presets já os excluíam do export. Versionados, eram 38 das 43 cenas do
# repositório: toda busca por cena do jogo devolvia demo de vendor. Um deles
# ainda registrava `class_name LaserProjectile` no namespace global do projeto.
# Consultar na origem do addon, não aqui. Ver docs/PROJECT_CONTRACT.md § Raízes.
guide_examples/
samples/

# ── Ruído de SO / editor ─────────────────────────────────────────────────────
.DS_Store
*.tmp
